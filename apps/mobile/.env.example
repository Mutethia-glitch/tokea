# Use accessible HTTPS API for real devices; localhost on your laptop is not reachable from a phone.
EXPO_PUBLIC_API_URL=https://your-tokea-api.example.com
# Register a real EAS project and replace the placeholder in app.json before push testing.

# Local sign-in returns signed tokens only when Africa's Talking OTP is configured.
# EXPO_PUBLIC_API_URL should be HTTPS for real phones; loopback is emulator-only.
# EAS project ID, Android FCM and iOS APNs must be provisioned by the owner.
