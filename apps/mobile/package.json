    "expo-notifications": "~58.1.9",
    "expo-constants": "~58.0.16",
    "expo-secure-store": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-screens": "*",
    "react-native-safe-area-context": "*",
    "expo-image-picker": "~58.0.10",
    "expo-file-system": "~58.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3",
    "sharp": "^0.35.5"
  }
