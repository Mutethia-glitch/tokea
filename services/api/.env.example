# Real database and trusted auth provider required; never commit actual secrets.
DATABASE_URL=postgresql://user:password@db.example.com:5432/tokea?sslmode=require
JWT_ISSUER=https://your-auth-provider.example/
JWT_AUDIENCE=tokea-api
JWT_JWKS_URL=https://your-auth-provider.example/.well-known/jwks.json
PORT=4400
# For private sandbox testing, bind only to your local machine.
HOST=127.0.0.1
# Push is off until the app is configured, a user opts in, and push credentials exist.
ENABLE_PUSH_WORKER=false
EXPO_ACCESS_TOKEN=

# Phone OTP: Africa's Talking SANDBOX only until live sender arrangements are approved.
ENABLE_PHONE_OTP=false
AFRICASTALKING_ENV=sandbox
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# Generate a unique random secret (at least 32 bytes) in your private password manager;
# never reuse an Africa's Talking key or commit this secret.
OTP_HMAC_SECRET=
