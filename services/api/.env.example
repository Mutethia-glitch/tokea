# No hosting. Environment variables are supplied locally and never committed.
DATABASE_URL=postgresql://tokea_dev:tokea_dev_only@127.0.0.1:5433/tokea_dev
JWT_ISSUER=https://your-trusted-identity-provider.example/
JWT_AUDIENCE=tokea-api
JWT_JWKS_URL=https://your-trusted-identity-provider.example/.well-known/jwks.json
PORT=4400
# ID collection FAILS CLOSED until owner explicitly configures secure local storage.
VERIFICATION_UPLOADS_ENABLED=false
# Generate a secret 32-byte encryption key using a safe secrets manager.
VERIFICATION_ENCRYPTION_KEY_BASE64=
# Private encrypted folder. Never sync, share, back up or put it in source control.
VERIFICATION_PHOTO_DIR=
# Phone push remains disabled until EAS/APNs/FCM credentials are configured.
ENABLE_PUSH_WORKER=false
EXPO_ACCESS_TOKEN=
# New admin invitations require a working provider; otherwise HTTP 503.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ADMIN_INVITES_FROM=
ADMIN_PANEL_URL=http://127.0.0.1:4400/admin
# Work-account sign-in (OAuth 2.0 authorization code + PKCE), no pasted tokens.
# Required from the selected identity provider; not yet provisioned.
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
ADMIN_OIDC_REDIRECT_URI=http://127.0.0.1:4400/admin
# Backend profile photo sync is encrypted and kept separate from disposable ID/selfie files.
PROFILE_PHOTOS_ENABLED=false
PROFILE_PHOTO_DIR=.profile-photos
PROFILE_PHOTO_KEY_BASE64=

# Kenya-based Africa's Talking OTP. Do not share or commit API keys.
OTP_AUTH_ENABLED=false
AT_MODE=sandbox
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Random 32+ character OTP HMAC secret. Real server-issued RSA private key file.
OTP_HMAC_SECRET=
AUTH_PRIVATE_KEY_FILE=.local-secrets/tokea-identity.pem
